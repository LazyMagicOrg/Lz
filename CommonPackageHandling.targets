<Project>
	<Import Project="$(SolutionDir)LzVersion.props" />
	<!-- Common properties for package handling -->
	<PropertyGroup>
		<PackageRepoFolder>$(SolutionDir)Packages</PackageRepoFolder>
		<Authors>Tim May, Thomas May</Authors>
		<Company>Insight Sciences Corporation</Company>
		<Copyright>Copyright (c) 2021 - 2026 Insight Sciences Corporation. All rights reserved.</Copyright>
		<!-- MIT, matching the sibling LazyMagic and LzRunner repos. The full text is
		     LICENSE.txt at the repo root, which is what GitHub reads; the SPDX
		     expression here is what puts a license on each Lz.* package. Use the
		     expression rather than PackageLicenseFile: the two are mutually exclusive,
		     and for a stock license the identifier is what NuGet recommends. -->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://LazyMagic.org</PackageProjectUrl>
		<RepositoryUrl>https://github.com/LazyMagicOrg/Lz</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Version>$(LzVersion)</Version>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<!-- Create Packages directory before build -->
	<Target Name="CreateDirectories" BeforeTargets="Build">
		<MakeDir Directories="$(PackageRepoFolder)"/>
	</Target>

	<!-- Copy Package to local feed -->
	<Target Name="CopyPackage" AfterTargets="Pack">
		<Message Importance="high" Text="Copying $(AssemblyName).$(Version).nupkg to Packages folder" />
		<MakeDir Directories="$(PackageRepoFolder)" />
		<Copy SourceFiles=".\bin\$(Configuration)\$(AssemblyName).$(Version).nupkg"
			  DestinationFiles="$(PackageRepoFolder)\$(AssemblyName).$(Version).nupkg" />
		<Copy Condition="Exists('.\bin\$(Configuration)\$(AssemblyName).$(Version).snupkg')"
			  SourceFiles=".\bin\$(Configuration)\$(AssemblyName).$(Version).snupkg"
			  DestinationFiles="$(PackageRepoFolder)\$(AssemblyName).$(Version).snupkg" />
	</Target>

	<!-- Delete Package from local cache to force fresh resolution -->
	<Target Name="DeletePackage" AfterTargets="Build">
		<MSBuild Projects="$(MSBuildProjectFile)" Targets="DeleteSpecificPackage" Properties="Configuration=$(Configuration)" />
	</Target>
	<Target Name="DeleteSpecificPackage">
		<PropertyGroup>
			<!-- Evict from the global-packages folder the restore ACTUALLY used, not a hardcoded
			     ~/.nuget/packages. $(NuGetPackageRoot) comes from the restore-generated nuget.g.props
			     and follows a per-workspace globalPackagesFolder set in the workspace NuGet.Config;
			     the old hardcoded path did not, so with a relocated cache this target evicted nothing
			     and the fixed-version republish it exists for silently stopped working. Falls back to
			     the NuGet default only when no restore has run. NuGet lowercases package ids on disk. -->
			<_PackageRoot>$(NuGetPackageRoot)</_PackageRoot>
			<_PackageRoot Condition=" '$(_PackageRoot)' == '' AND '$(OS)' == 'Windows_NT' ">$(UserProfile)\.nuget\packages\</_PackageRoot>
			<_PackageRoot Condition=" '$(_PackageRoot)' == '' AND '$(OS)' != 'Windows_NT' ">$(Home)/.nuget/packages/</_PackageRoot>
			<_PackageRoot>$([MSBuild]::EnsureTrailingSlash('$(_PackageRoot)'))</_PackageRoot>
			<PackageCacheFolder Condition=" '$(OS)' == 'Windows_NT' ">$(_PackageRoot)$(AssemblyName.ToLowerInvariant())\$(Version)</PackageCacheFolder>
			<PackageCacheFolder Condition=" '$(OS)' != 'Windows_NT' ">$(_PackageRoot)$(AssemblyName.ToLowerInvariant())/$(Version)</PackageCacheFolder>
		</PropertyGroup>
		<Message Importance="high" Text="Attempting to delete package $(AssemblyName) version $(Version) from cache folder $(PackageCacheFolder)" />
		<!-- Windows-specific delete command -->
		<Exec Condition=" '$(OS)' == 'Windows_NT' AND Exists('$(PackageCacheFolder)')"
			  Command="cmd.exe /c &quot;if exist &quot;$(PackageCacheFolder)&quot; rmdir /s /q &quot;$(PackageCacheFolder)&quot;&quot;"
			  ContinueOnError="true">
			<Output TaskParameter="ExitCode" PropertyName="ErrorCode"/>
		</Exec>
		<!-- Unix/Linux/Mac-specific delete command -->
		<Exec Condition=" '$(OS)' != 'Windows_NT' AND Exists('$(PackageCacheFolder)')"
			  Command="rm -rf &quot;$(PackageCacheFolder)&quot;"
			  ContinueOnError="true">
			<Output TaskParameter="ExitCode" PropertyName="ErrorCode"/>
		</Exec>
		<Message Condition="'$(ErrorCode)' != '0'" Importance="high" Text="Failed to delete package. Error code: $(ErrorCode)" />
		<Message Condition="'$(ErrorCode)' == '0'" Importance="high" Text="Successfully deleted package from $(PackageCacheFolder)" />
	</Target>
</Project>
