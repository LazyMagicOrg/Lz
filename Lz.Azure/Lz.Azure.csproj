<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(SolutionDir)CommonPackageHandling.targets" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lz.Azure</RootNamespace>
    <PackageId>Lz.Azure</PackageId>
    <Description>Lz Azure platform implementations</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lz.Core\Lz.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pulumi.AzureNative 2.92+ transitively requires Pulumi >= 3.106.2,
         which conflicts with Lz.Core's hard pin of Pulumi == [3.105.0]
         (assembly identity must match across the host/plugin boundary —
         see Lz.Core.csproj). Cap Pulumi.AzureNative below 2.92 until
         Lz.Core's Pulumi pin is bumped in lockstep. Mirrors the
         Pulumi.Aws cap pattern in Lz.Aws.csproj. -->
    <PackageReference Include="Pulumi.AzureNative" Version="[2.0.0, 2.92.0)" />
  </ItemGroup>

</Project>
