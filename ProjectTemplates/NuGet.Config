<?xml version="1.0" encoding="utf-8"?>
<!-- lz-build-only. Adds the LazyMagic local package feed so the framework ProjectTemplates
     (which reference LazyMagic.* packages not published to nuget.org) can be restored and
     COMPILED as members of lz.slnx. No <clear/>, so nuget.org (and the Lz feed from
     lz/NuGet.Config) are still inherited. NOT shipped with the templates (excluded from the
     Lz.Gen Content glob); generated systems supply their own NuGet.Config. -->
<configuration>
  <packageSources>
    <add key="LazyMagicLocal" value="..\..\LazyMagic\Packages" />
  </packageSources>
</configuration>
