<?xml version="1.0" encoding="utf-8"?>
<!--
  THE LOCAL-LANE RESTORE CONFIG FOR THE IMAGE BUILD. Selected by `PackageLane=local`, which is what
  `lz deploycontainer` passes (containersbuild.scu.dev.yaml). This is the developer/deploy loop that
  works today.

  ITS CONTENT IS BYTE-FOR-BYTE WHAT THE DOCKERFILE USED TO GENERATE with a chain of `echo`
  redirects, and that is deliberate: moving it into a committed file is meant to change WHERE the
  config comes from, not WHAT it says. The local lane behaves exactly as before.

  /src/DockerPackages IS LOAD-BEARING. `DockerPackageSyncer` deletes and recreates it inside the
  build context on every `lz deploycontainer`, filling it from a HOST restore - so it carries
  whatever lane the workspace was in. That coupling is a feature here and a disqualifier for a
  signed artifact, which is why the published lane exists beside it rather than replacing it.

  A STALE DockerPackages IS A FOLDER THE SYNCER HAS NOT RUN OVER - not evidence it copies the wrong
  thing. Running `docker build` directly, skipping `lz deploycontainer`, restores against whatever
  was left there; on 2026-09-08 that was a set from months earlier.

  PREFIXED FILENAME for the same reason as its published sibling: this directory is on AipHost's
  config-discovery chain, so a file named `NuGet.Config` here would be found by every ordinary
  build of the project and its `<clear/>` would delete the ancestor workspace's feeds.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="DockerCache" value="/src/DockerPackages" />
    <add key="nuget.org"   value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
