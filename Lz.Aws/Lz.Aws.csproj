<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(SolutionDir)CommonPackageHandling.targets" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lz.Aws</RootNamespace>
    <PackageId>Lz.Aws</PackageId>
    <Description>Lz AWS platform implementations (ECS, Lambda, CloudFront, etc.)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lz.Core\Lz.Core.csproj" />
  </ItemGroup>

  <!-- Pre-built Lambda package — ships with the tool so FindProjectRoot() is unnecessary -->
  <ItemGroup>
    <Content Include="Lambda\gate-checker.zip" Condition="Exists('Lambda\gate-checker.zip')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Lambda\gate-checker.zip</Link>
    </Content>
  </ItemGroup>

  <Target Name="WarnMissingGateChecker" BeforeTargets="Build"
          Condition="!Exists('Lambda\gate-checker.zip')">
    <Warning Text="Lambda/gate-checker.zip is missing. Run Lambda/build-gate-checker.ps1 to build it." />
  </Target>

  <ItemGroup>
    <PackageReference Include="AWSSDK.AppRunner" Version="4.*" />
    <PackageReference Include="AWSSDK.AutoScaling" Version="4.*" />
    <PackageReference Include="AWSSDK.CloudFront" Version="4.*" />
    <PackageReference Include="AWSSDK.CloudFrontKeyValueStore" Version="4.*" />
    <PackageReference Include="AWSSDK.Extensions.CrtIntegration" Version="4.*" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.*" />
    <PackageReference Include="AWSSDK.ECR" Version="4.*" />
    <PackageReference Include="AWSSDK.ECS" Version="4.0.14" />
    <PackageReference Include="AWSSDK.KeyManagementService" Version="4.*" />
    <PackageReference Include="AWSSDK.Lambda" Version="4.*" />
    <PackageReference Include="AWSSDK.RDS" Version="4.*" />
    <PackageReference Include="AWSSDK.Route53" Version="4.*" />
    <PackageReference Include="AWSSDK.S3" Version="4.*" />
    <PackageReference Include="AWSSDK.EC2" Version="4.*" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.4.7" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.*" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.*" />
    <PackageReference Include="AWSSDK.SSO" Version="4.0.2.14" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.3.15" />
    <PackageReference Include="Pulumi.Aws" Version="6.*" />
    <PackageReference Include="Pulumi.Random" Version="4.*" />
    <PackageReference Include="NUglify" Version="1.*" />
  </ItemGroup>

</Project>
