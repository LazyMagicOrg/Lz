<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(SolutionDir)CommonPackageHandling.targets" />
  <Import Project="$(SolutionDir)LzVersioning.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lz.Aws</RootNamespace>
    <PackageId>Lz.Aws</PackageId>
    <Description>Lz AWS platform implementations (ECS, Lambda, CloudFront, etc.)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lz.Core\Lz.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lz.Tests" />
  </ItemGroup>

  <!-- Pre-built Lambda package. AwsGateCheckerLambdaComponent looks for
       Lambda/gate-checker.zip relative to Assembly.Location of the loaded
       Lz.Aws.dll. Depending on the host process's assembly load behavior,
       Assembly.Location can resolve to one of two places. We ship the zip
       into BOTH so both paths work, since which one wins at runtime
       depends on subtleties of .NET's load context probing order.

       Path A: NuGet cache, when AssemblyDependencyResolver.Resolving
       fires (deps.json based resolution to the cache).
         lib/$(TargetFramework)/Lambda/gate-checker.zip in the nupkg
         -> mirrored to
            <global-packages folder>/lz.aws/{ver}/lib/net10.0/Lambda/gate-checker.zip
            (~/.nuget/packages by default, or the workspace globalPackagesFolder)

       Path B: Consumer's local bin, when .NET's default ALC LoadFrom
       probing finds the locally-copied Lz.Aws.dll alongside the
       LoadFrom'd plugin Deploy.dll (default probing succeeds before
       Resolving fires).
         contentFiles/any/$(TargetFramework)/Lambda/gate-checker.zip
         with PackageCopyToOutput=true
         -> flowed to Deploy/bin/{Config}/net10.0/Lambda/gate-checker.zip

       The source <None> with CopyToOutputDirectory handles a third
       scenario: ProjectReference within the lz solution itself
       (Lz.Cli -> Lz.Aws), where the zip flows from Lz.Aws's own bin
       into Lz.Cli's bin via normal MSBuild copy. -->
  <ItemGroup>
    <None Include="Lambda\gate-checker.zip" Condition="Exists('Lambda\gate-checker.zip')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>false</Pack>
    </None>
    <None Include="Lambda\gate-checker.zip" Condition="Exists('Lambda\gate-checker.zip')"
          Pack="true" PackagePath="lib\$(TargetFramework)\Lambda\gate-checker.zip" />
    <None Include="Lambda\gate-checker.zip" Condition="Exists('Lambda\gate-checker.zip')"
          Pack="true" PackagePath="contentFiles\any\$(TargetFramework)\Lambda\gate-checker.zip">
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <BuildAction>None</BuildAction>
    </None>
  </ItemGroup>

  <Target Name="WarnMissingGateChecker" BeforeTargets="Build"
          Condition="!Exists('Lambda\gate-checker.zip')">
    <Warning Text="Lambda/gate-checker.zip is missing. Run Lambda/build-gate-checker.ps1 to build it." />
  </Target>

  <!-- THE DECOUPLED-CD DEPLOYER'S PACKAGES (DecoupledCd.md §5, P2 stage C3): Lambda/deployer.zip and
       Lambda/signature-hook.zip, which `lz bootstrapdeployer` uploads.

       BUILT HERE, EVERY BUILD — NOT COMMITTED like gate-checker.zip. Those functions run the pipeline's
       deploy decisions, and a committed zip is a copy of that code that drifts the first time someone
       edits a decision and does not rebuild it: the suite would stay green on the source while the
       account ran the old logic. Building it with Lz.Aws means the package in the nupkg is always the
       code the tests just ran against.

       The ProjectReference exists to put Lz.Aws.Deployer in the restore graph and the build order —
       `dotnet run \-\-project Lz.Cli` in CI builds project by project and would otherwise publish an
       unrestored project. It references no assembly (the deployer compiles some of Lz.Aws's own files,
       so referencing its output would define those types twice), excludes every asset so the
       deployer's packages do not flow into Lz.Aws, and is PrivateAssets so the nupkg does not declare
       a dependency on a package that does not exist.

       Shipped in the same three places as gate-checker.zip, for the same three load scenarios. -->
  <ItemGroup>
    <ProjectReference Include="..\Lz.Aws.Deployer\Lz.Aws.Deployer.csproj"
                      ReferenceOutputAssembly="false" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!-- Forward slashes in the new paths: MSBuild takes them on Windows, and CI builds this on Linux. -->
  <PropertyGroup>
    <LzLambdaDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)lambda/</LzLambdaDir>
  </PropertyGroup>

  <ItemGroup>
    <LzDeployerPackage Include="$(LzLambdaDir)deployer.zip" />
    <LzDeployerPackage Include="$(LzLambdaDir)signature-hook.zip" />

    <None Include="@(LzDeployerPackage)" Link="Lambda\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Pack="false" Visible="false" />
    <None Include="@(LzDeployerPackage)" Pack="true" Visible="false"
          PackagePath="lib\$(TargetFramework)\Lambda\%(Filename)%(Extension)" />
    <None Include="@(LzDeployerPackage)" Pack="true" Visible="false"
          PackagePath="contentFiles\any\$(TargetFramework)\Lambda\%(Filename)%(Extension)">
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <BuildAction>None</BuildAction>
    </None>
  </ItemGroup>

  <Target Name="LzBuildDeployerPackages" AfterTargets="ResolveProjectReferences" BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_LzPublishDir>$(LzLambdaDir)publish/</_LzPublishDir>
      <_LzHookDir>$(LzLambdaDir)signature-hook/</_LzHookDir>
      <_LzVerifierDir>$(MSBuildProjectDirectory)/../Lz.Aws.Deployer/notation/</_LzVerifierDir>
    </PropertyGroup>

    <!-- A clean directory each time, so a dependency that was removed does not linger in the zip. -->
    <RemoveDir Directories="$(_LzPublishDir);$(_LzHookDir)" />

    <!-- NoBuild: the ProjectReference above has just built it with these same global properties, so
         publishing must not compile it a second time into the same obj directory. -->
    <MSBuild Projects="../Lz.Aws.Deployer/Lz.Aws.Deployer.csproj" Targets="Publish"
             Properties="NoBuild=true;PublishDir=$(_LzPublishDir)" />

    <ItemGroup>
      <_LzPublished Include="$(_LzPublishDir)**/*" />
      <_LzVerifier Include="$(_LzVerifierDir)*" />
    </ItemGroup>

    <ZipDirectory SourceDirectory="$(_LzPublishDir)" DestinationFile="$(LzLambdaDir)deployer.zip" Overwrite="true" />

    <Copy SourceFiles="@(_LzPublished)" DestinationFiles="@(_LzPublished->'$(_LzHookDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_LzVerifier)" DestinationFolder="$(_LzHookDir)notation/" />
    <ZipDirectory SourceDirectory="$(_LzHookDir)" DestinationFile="$(LzLambdaDir)signature-hook.zip" Overwrite="true" />

    <Message Importance="high" Condition="'@(_LzVerifier)' == ''"
             Text="Lz.Aws: signature-hook.zip built WITHOUT the Notation verifier (Lz.Aws.Deployer/notation/ is empty). The hook will refuse every deployment until it is packaged." />
  </Target>

  <!-- M0-7 Cognito Custom-Auth trigger (inline Node.js). AwsCognitoComponent zips the
       CognitoCustomAuth/ dir found next to typeof(...).Assembly.Location, so custom-auth.mjs must
       land at <asmDir>/CognitoCustomAuth/custom-auth.mjs in all three load scenarios — identical to
       the gate-checker.zip handling above. The source lives at Auth/CognitoCustomAuth/, so each
       item uses Link (local copy) or PackagePath (nupkg) to strip the Auth/ prefix.

       ONLY custom-auth.mjs ships — custom-auth.test.mjs is deliberately excluded so the node test
       file never reaches the deployed Lambda zip. -->
  <ItemGroup>
    <!-- Path A: NuGet-cache resolution (lib/ in the nupkg). -->
    <None Include="Auth\CognitoCustomAuth\custom-auth.mjs"
          Pack="true" PackagePath="lib\$(TargetFramework)\CognitoCustomAuth\custom-auth.mjs" />
    <!-- Path B: consumer's local bin via contentFiles + PackageCopyToOutput (plugin LoadFrom). -->
    <None Include="Auth\CognitoCustomAuth\custom-auth.mjs"
          Pack="true" PackagePath="contentFiles\any\$(TargetFramework)\CognitoCustomAuth\custom-auth.mjs">
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <BuildAction>None</BuildAction>
    </None>
    <!-- Path C: ProjectReference within the lz solution (Lz.Cli -> Lz.Aws) — normal MSBuild copy. -->
    <None Include="Auth\CognitoCustomAuth\custom-auth.mjs">
      <Link>CognitoCustomAuth\custom-auth.mjs</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>false</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.AppRunner" Version="4.*" />
    <PackageReference Include="AWSSDK.AutoScaling" Version="4.*" />
    <PackageReference Include="AWSSDK.CertificateManager" Version="4.*" />
    <PackageReference Include="AWSSDK.CloudFront" Version="4.*" />
    <PackageReference Include="AWSSDK.CloudFrontKeyValueStore" Version="4.*" />
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="4.*" />
    <PackageReference Include="AWSSDK.CognitoIdentity" Version="4.*" />
    <PackageReference Include="AWSSDK.CognitoIdentityProvider" Version="4.*" />
    <PackageReference Include="AWSSDK.Extensions.CrtIntegration" Version="4.*" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.*" />
    <PackageReference Include="AWSSDK.ECR" Version="4.*" />
    <PackageReference Include="AWSSDK.IdentityManagement" Version="4.*" />
    <PackageReference Include="AWSSDK.ECS" Version="4.0.14" />
    <PackageReference Include="AWSSDK.ElasticLoadBalancingV2" Version="4.*" />
    <PackageReference Include="AWSSDK.KeyManagementService" Version="4.*" />
    <PackageReference Include="AWSSDK.Lambda" Version="4.*" />
    <PackageReference Include="AWSSDK.RDS" Version="4.*" />
    <PackageReference Include="AWSSDK.Route53" Version="4.*" />
    <PackageReference Include="AWSSDK.S3" Version="4.*" />
    <!-- Signer: the pipeline's signing profiles (DecoupledCd.md §4.2). ECR managed signing signs
         images at push under a profile, and Notation verifies against the profile ARN — which is
         how provenance is expressed. -->
    <PackageReference Include="AWSSDK.Signer" Version="4.*" />
    <!-- StepFunctions: the in-account deployer's state machine (§5.1). Standard workflows only —
         .waitForTaskToken, which the approval gate needs, does not exist on Express. -->
    <PackageReference Include="AWSSDK.StepFunctions" Version="4.*" />
    <PackageReference Include="AWSSDK.EC2" Version="4.*" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.4.7" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.*" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.*" />
    <PackageReference Include="AWSSDK.SSO" Version="4.0.2.14" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.3.15" />
    <PackageReference Include="Pulumi.Aws" Version="7.*" />
    <PackageReference Include="Pulumi.Random" Version="4.*" />
    <PackageReference Include="NUglify" Version="1.*" />
  </ItemGroup>

</Project>
