<!--
  Lz solution — the infrastructure logic that the `lz` dispatcher loads.
  As of LzVersion 0.9.218, Lz.Runner has been split into its own repo
  (https://github.com/LazyMagicOrg/LzRunner) and is no longer part of this
  solution. The runner is installed globally via `dotnet tool install -g
  Lz.Runner` and consumes the packages this solution produces.
  See Platform/LzRunnerSplit.md in any Monro working copy for the rationale.
-->
<Solution>
  <Project Path="Lz.Aws/Lz.Aws.csproj" />
  <Project Path="Lz.Azure/Lz.Azure.csproj" />
  <Project Path="Lz.Core/Lz.Core.csproj" />
  <Project Path="Lz.Gen/Lz.Gen.csproj" />
  <Project Path="Lz.Tests/Lz.Tests.csproj" />
  <Project Path="Lz.Cli/Lz.Cli.csproj" />
  <!-- Framework code-gen templates. Built (not just shipped as Content) so contamination
       like dangling ProjectReferences is caught at build time. See ProjectTemplates/README.md. -->
  <Folder Name="/ProjectTemplates/">
    <Project Path="ProjectTemplates/ApiLambda/ApiLambda.csproj" />
    <Project Path="ProjectTemplates/AppSyncEventsSDK/AppSyncEventsSDK.csproj" />
    <Project Path="ProjectTemplates/AspDotNetHost/AspDotNetHost.csproj" />
    <Project Path="ProjectTemplates/Authorization/Authorization.csproj" />
    <Project Path="ProjectTemplates/BasicLib/BasicLib.csproj" />
    <Project Path="ProjectTemplates/ClientSDK/ClientSDK.csproj" />
    <Project Path="ProjectTemplates/Controller/Controller.csproj" />
    <Project Path="ProjectTemplates/ModuleClientInterface/ModuleClientInterface.csproj" />
    <Project Path="ProjectTemplates/Repo/Repo.csproj" />
    <Project Path="ProjectTemplates/Schema/Schema.csproj" />
    <Project Path="ProjectTemplates/WebApi/WebApi.csproj" />
  </Folder>
</Solution>
