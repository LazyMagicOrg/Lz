<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(SolutionDir)CommonPackageHandling.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lz.Runner</RootNamespace>

    <!-- Global tool packaging. Same ToolCommandName as Lz.Cli — once the runner
         is installed, it owns the `lz` command and invokes the right Lz.Cli DLL
         via `dotnet <dll>` rather than via a shim. Users uninstall Lz.Cli once
         (`dotnet tool uninstall -g lz.cli`) before installing this. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lz</ToolCommandName>
    <PackageId>Lz.Runner</PackageId>
    <Version>$(LzVersion)</Version>
    <Description>Lz dispatcher — resolves the correct Lz.Cli version from the in-scope NuGet.Config and invokes it. Installs as `lz`.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bake the build-origin Packages path + version into the assembly so
         the dispatcher can fall back to "the feed I was built from, at my
         installed version" when cwd has no NuGet.Config in its ancestry. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Lz.Runner.BuildOriginPackages</_Parameter1>
      <_Parameter2>$(SolutionDir)Packages</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Lz.Runner.DefaultCliVersion</_Parameter1>
      <_Parameter2>$(LzVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
