<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(SolutionDir)CommonPackageHandling.targets" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Lz.Gen</RootNamespace>
    <PackageId>Lz.Gen</PackageId>
    <Description>Lz model-driven code generator (ported from LazyMagicMDD)</Description>
    <!-- Templates and AWS SAM snippets ship as content and are also packed -->
    <ContentTargetFolders>contentFiles\any\any;content</ContentTargetFolders>
    <!-- Keep SDK-default globs from sweeping template .cs/.csproj/.yaml etc.
         into Compile/EmbeddedResource/None. Re-added explicitly as Content below. -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);ProjectTemplates\**;AWSTemplates\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core routing primitives (e.g. Microsoft.AspNetCore.Routing.Template.TemplateParser)
         used when parsing OpenAPI path templates. Framework-reference avoids pulling NSwag's
         12.x-capped SwaggerGeneration.AspNetCore package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeepCloner" Version="0.10.4" />
    <PackageReference Include="DotNet.Glob" Version="3.1.3" />
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <PackageReference Include="NSwag.CodeGeneration.CSharp" Version="14.0.3" />
    <PackageReference Include="NSwag.Core.Yaml" Version="14.0.3" />
    <PackageReference Include="YamlDotNet" Version="16.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- FlowThroughHelpers.tpl is loaded as an embedded resource by DotNetControllerProject -->
    <EmbeddedResource Include="ArtifactGeneration\ModuleArtifacts\FlowThroughHelpers.tpl">
      <LogicalName>Lz.Gen.ArtifactGeneration.ModuleArtifacts.FlowThroughHelpers.tpl</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Ship project templates and AWS SAM snippets alongside the assembly so
         LzGenSolution can resolve them from AppContext.BaseDirectory when a
         user's solution doesn't supply local overrides. -->
    <Content Include="ProjectTemplates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\ProjectTemplates\;content\ProjectTemplates\</PackagePath>
    </Content>
    <Content Include="AWSTemplates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\AWSTemplates\;content\AWSTemplates\</PackagePath>
    </Content>
  </ItemGroup>

</Project>
