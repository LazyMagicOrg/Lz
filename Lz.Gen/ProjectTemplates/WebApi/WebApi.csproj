<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Description>A Local WebApi for local debugging</Description>
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UserSecretsId>monro-localwebservice</UserSecretsId>
	</PropertyGroup>
	<Import Project="User.props"  Condition="Exists('User.props')" />
	<ItemGroup>
		<PackageReference Include="LazyMagic.Service.Shared" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="System.Threading.Channels" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" />
		<PackageReference Include="NetEscapades.Configuration.Yaml" />
		<PackageReference Include="Serilog.AspNetCore" />
		<PackageReference Include="Serilog.Sinks.File" />
		<PackageReference Include="AWSSDK.SSO" />
		<PackageReference Include="AWSSDK.SSOOIDC" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="$(SolutionDir)Modules\UtilModule\UtilModule.csproj" />
		<ProjectReference Include="$(SolutionDir)Services\Authentication\Authentication.csproj" />
		<ProjectReference Include="$(SolutionDir)Services\HostingMiddleware\HostingMiddleware.csproj" />
		<ProjectReference Include="$(SolutionDir)Services\Secrets.ASM\Secrets.ASM.csproj" />
		<ProjectReference Include="$(SolutionDir)Services\Integrations\Integrations.csproj" />
		<ProjectReference Include="$(SolutionDir)Services\RequestRewriter.Base\RequestRewriter.Base.csproj" />
		<ProjectReference Include="$(SolutionDir)Services\RequestRewriter.Service\RequestRewriter.Service.csproj" />
	</ItemGroup>
	<Import Project="Projects.g.props"  Condition="Exists('Projects.g.props')"  />
	<Import Project="Packages.g.props"  Condition="Exists('Packages.g.props')"  />
</Project>
